<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino5_v6">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fairino5_v6 urdf file -->
    <xacro:include filename="$(find fairino5_v6_description)/urdf/fairino5_v6_1.urdf.xacro" />

    <!-- Import control_xacro -->
    <!-- <xacro:include filename="fairino5_v6.ros2_control.xacro" />


    <xacro:fairino5_v6_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/> -->

</robot>
